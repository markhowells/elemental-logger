# Marine Pi per-vessel configuration  ->  copy to /etc/marine/marine.env (mode 0600, root).
#
# This file holds the secrets and site-specific values. It is NEVER committed with real
# values and never baked into an image. Everything else (templates, scripts, image pins)
# comes from the versioned release. Format: KEY=VALUE, one per line, no quotes needed,
# no shell expansion ('$' is not special here but is refused in values used by docker compose).
# Every 'changeme' must be replaced; marine-apply refuses to run otherwise.

# --- WiFi access point ---------------------------------------------------------------
WIFI_SSID=changeme
WIFI_PASSWORD=changeme
WIFI_COUNTRY=GB

# --- Portainer admin account (12+ chars) ------------------------------------------------
PORTAINER_ADMIN_PASSWORD=changeme

# --- InfluxDB --------------------------------------------------------------------------
INFLUXDB_USERNAME=changeme
INFLUXDB_PASSWORD=changeme
# Operator token, at least 32 chars:  openssl rand -hex 32
# On an EXISTING data volume this must match the token already in InfluxDB.
INFLUXDB_TOKEN=changeme
# Where SignalK writes. These MUST match the live InfluxDB; the plugin config is rendered from them.
INFLUXDB_ORG=changeme
INFLUXDB_BUCKET=changeme

# --- Vessel identity (written into SignalK settings) ---------------------------------------
VESSEL_NAME=changeme
VESSEL_MMSI=

# --- Optional ---------------------------------------------------------------------------
# CAN interface SignalK reads. Leave as can0 on the boat; tools/canswitch.sh sets vcan0 for bench tests.
#CAN_INTERFACE=can0
# Hostname suffix served by the Pi (dnsmasq wildcard + Caddy virtual hosts).
#DOMAIN=elemental.internal
# off = plain HTTP on the WPA2 AP (default). internal = Caddy's own CA (devices must trust its root cert once).
#TLS_MODE=off
# yes = marine-update applies a staged release by itself; no = it only stages (apply with marine-update --apply).
#AUTO_APPLY=no
# Anonymous (no login) read access to SignalK on the boat network.
#SIGNALK_ALLOW_READONLY=false
# InfluxDB write volume. Defaults reproduce today's behaviour (everything, every update).
# Recommended to cut the 40 Hz switch-bank state: resolution 1000 and ignore electrical.switches.bank.*
#INFLUX_RESOLUTION_MS=0
#INFLUX_IGNORED_PATHS=
#INFLUX_PLUGIN_DEBUG=true
