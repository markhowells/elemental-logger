[Unit]
Description=Portainer CE
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=SCRIPT_DIR_PLACEHOLDER
ExecStart=/usr/bin/docker compose -f SCRIPT_DIR_PLACEHOLDER/portainer-bootstrap.yml up -d
ExecStop=/usr/bin/docker compose -f SCRIPT_DIR_PLACEHOLDER/portainer-bootstrap.yml down
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
