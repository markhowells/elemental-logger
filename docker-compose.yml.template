networks:
  marine_net:
    driver: bridge

services:
  signalk:
    image: marine-signalk:latest
    container_name: signalk
    restart: unless-stopped
    network_mode: host
    volumes:
      - signalk_data:/home/node/.signalk
      - SCRIPT_DIR_PLACEHOLDER/config/signalk/plugin-config-data/signalk-to-influxdb2.json:/home/node/.signalk-defaults/plugin-config-data/signalk-to-influxdb2.json:ro

  influxdb:
    image: influxdb:2.7
    container_name: influxdb
    restart: unless-stopped
    networks:
      - marine_net
    ports:
      - "8086:8086"
    volumes:
      - influxdb_data:/var/lib/influxdb2
      - influxdb_config:/etc/influxdb2
    environment:
      - DOCKER_INFLUXDB_INIT_MODE=setup
      - DOCKER_INFLUXDB_INIT_USERNAME=INFLUXDB_USERNAME_PLACEHOLDER
      - DOCKER_INFLUXDB_INIT_PASSWORD=INFLUXDB_PASSWORD_PLACEHOLDER
      - DOCKER_INFLUXDB_INIT_ORG=INFLUXDB_ORG_PLACEHOLDER
      - DOCKER_INFLUXDB_INIT_BUCKET=INFLUXDB_BUCKET_PLACEHOLDER
      - DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=INFLUXDB_TOKEN_PLACEHOLDER
      - DOCKER_INFLUXDB_INIT_RETENTION=0

volumes:
  signalk_data:
  influxdb_data:
  influxdb_config:

