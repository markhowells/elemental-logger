# Pinned image references (tag@digest). In a release, CI rewrites SIGNALK_IMAGE with the
# registry digest it just built; the others are bumped deliberately (Dependabot/Renovate PRs).
#
# Until CI publishes images, SIGNALK_IMAGE is the locally built image (current behaviour).
SIGNALK_IMAGE=marine-signalk:latest
# These digests are EXACTLY what runs on the boat today (checked 2026-11-24), so the first
# apply is a no-op for them. Bump on purpose; a Portainer/InfluxDB upgrade is a real change.
INFLUXDB_IMAGE=influxdb:2.7@sha256:d20f6e4394e50af81453a8c86f28fcc5f9b0a9cace8f1e017c61466f9ad49941
PORTAINER_IMAGE=portainer/portainer-ce:latest@sha256:1ae8e65d50ca5498cb2c33e617495a1e3ef245b0d2392b4a44c70ae09b822891
# New service (landing page / reverse proxy).
CADDY_IMAGE=caddy:2@sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b
