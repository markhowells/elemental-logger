# Real per-vessel secrets never belong in the repo (they live in /etc/marine/marine.env on the Pi).
marine.env
*.env
!marine.env.example
!deploy/images.env
!tests/fixtures/*.env

# Rendered output (anything generated from templates)
rendered/

# Leftovers generated by the pre-release setup.sh in older checkouts
/docker-compose.yml
config/signalk/settings.json
config/signalk/plugin-config-data/

# Local Claude Code settings
.claude/settings.local.json
__pycache__/
