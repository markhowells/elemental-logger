#!/usr/bin/env node
'use strict';
/**
 * Drop-in replacement for `analyzer -json -si -camel` (from canboat).
 * n2kAnalyzer in @signalk/streams spawns this command, feeds it Actisense
 * serial format on stdin, and expects one JSON object per line on stdout.
 * We implement it using canboatjs's FromPgn which is already in the image.
 */

function requireCanboatjs() {
  const bases = [
    '/home/node/signalk/node_modules',
    '/home/node/signalk/node_modules/signalk-server/node_modules',
  ];
  for (const base of bases) {
    try {
      return require(`${base}/@canboat/canboatjs`);
    } catch (_) {}
  }
  throw new Error('Cannot find @canboat/canboatjs');
}

const { FromPgn } = requireCanboatjs();
const readline = require('readline');

// n2kAnalyzer checks for a line with 'version' and logs it — satisfy that handshake
process.stdout.write(JSON.stringify({ version: 'canboatjs' }) + '\n');

const fromPgn = new FromPgn({ useCamelCompat: true });

fromPgn.on('warning', (pgn, warning) => {
  process.stderr.write(`[analyzer] PGN ${pgn.pgn}: ${warning}\n`);
});
fromPgn.on('error', () => { /* suppress unhandled-error crash for unknown PGNs */ });

const rl = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });

rl.on('line', (line) => {
  const trimmed = line.trim();
  if (!trimmed) return;
  try {
    const result = fromPgn.parse(trimmed);
    if (result) {
      process.stdout.write(JSON.stringify(result) + '\n');
    }
  } catch (e) {
    process.stderr.write(`[analyzer] ${e.message}\n`);
  }
});
